---
import type { BlogPost } from "../lib/posts";
import { categoryLabel, formatDate } from "../lib/posts";
import { categoryPath } from "../lib/paths";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, language } = post.data;
---

<BaseLayout title={title} description={description} type="article" language={language}>
  <article class="article">
    <header class="article-header">
      <a class="eyebrow" href={categoryPath(category)}>{categoryLabel(category)}</a>
      <h1>{title}</h1>
      <p class="dek">{description}</p>
      <div class="article-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span>Updated {formatDate(updatedDate)}</span>}
      </div>
    </header>

    <div class="article-body">
      <slot />
    </div>

    {tags.length > 0 && (
      <footer class="article-tags" aria-label="Tags">
        {tags.map((tag) => <span>#{tag}</span>)}
      </footer>
    )}
  </article>
</BaseLayout>

<style>
  .article {
    margin-inline: auto;
    max-width: 72rem;
    padding-top: clamp(3.5rem, 8vw, 7rem);
  }

  .article-header {
    margin: 0 auto clamp(3rem, 7vw, 5.5rem);
    max-width: 54rem;
    text-align: center;
  }

  .eyebrow {
    color: var(--color-clay);
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    margin: 0 0 1.4rem;
    text-decoration-color: transparent;
    text-underline-offset: 0.3rem;
  }

  .eyebrow:hover {
    text-decoration-color: currentColor;
  }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.3rem, 6vw, 4.8rem);
    font-weight: 400;
    letter-spacing: 0.05em;
    line-height: 1.45;
    margin: 0;
  }

  .dek {
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 2;
    margin: 1.8rem auto 0;
    max-width: 37rem;
  }

  .article-meta {
    display: flex;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    gap: 1rem;
    justify-content: center;
    letter-spacing: 0.12em;
    margin-top: 1.6rem;
  }

  .article-body {
    font-family: var(--font-serif);
    font-size: 1rem;
    letter-spacing: 0.00625em;
    line-height: 1.65;
    margin-inline: auto;
    max-width: 49.375rem;
  }

  .article-body :global(h2) {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.25;
    margin: 4rem 0 1.25rem;
  }

  .article-body :global(h3) {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
    margin: 2.75rem 0 0.9rem;
  }

  .article-body :global(p) {
    margin: 0 0 1.5rem;
  }

  .article-body :global(a) {
    color: var(--color-indigo);
    text-decoration-color: var(--color-clay);
    text-underline-offset: 0.24rem;
  }

  .article-body :global(blockquote) {
    border-left: 2px solid var(--color-clay);
    color: var(--color-muted);
    line-height: 1.75;
    margin: 2.25rem 0;
    padding: 0.15rem 0 0.15rem 1.5rem;
  }

  .article-body :global(code) {
    background: color-mix(in srgb, var(--color-leaf) 9%, transparent);
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 0.16em 0.32em;
  }

  .article-body :global(pre) {
    background: var(--color-ink);
    color: var(--color-paper);
    line-height: 1.55;
    overflow-x: auto;
    padding: 1.35rem;
  }

  .article-body :global(pre code) {
    background: transparent;
    padding: 0;
  }

  .article-body :global(img) {
    border: 1px solid var(--color-line-soft);
    margin: 2.6rem auto;
  }

  .article-body :global(table) {
    border-collapse: collapse;
    display: block;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    line-height: 1.65;
    margin: 2.4rem 0;
    overflow-x: auto;
    width: 100%;
  }

  .article-body :global(th),
  .article-body :global(td) {
    border-bottom: 1px solid var(--color-line-soft);
    padding: 0.7rem 0.9rem;
    text-align: left;
    vertical-align: top;
  }

  .article-body :global(th) {
    border-bottom-color: var(--color-line);
    color: var(--color-leaf);
    font-weight: 600;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.4rem;
  }

  .article-body :global(li + li) {
    margin-top: 0.35rem;
  }

  .article-body :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-line-soft);
    margin: 3.5rem 0;
  }

  .article-tags {
    border-top: 1px solid var(--color-line);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.78rem;
    gap: 1rem;
    margin: 5rem auto 0;
    max-width: 49.375rem;
    padding-top: 1.4rem;
  }
</style>

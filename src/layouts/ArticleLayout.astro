---
import type { BlogPost } from "../lib/posts";
import { categoryLabels, formatDate } from "../lib/posts";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags } = post.data;
---

<BaseLayout title={title} description={description} type="article">
  <article class="article">
    <header class="article-header">
      <p class="eyebrow">{categoryLabels[category]}</p>
      <h1>{title}</h1>
      <p class="dek">{description}</p>
      <div class="article-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span>更新 {formatDate(updatedDate)}</span>}
      </div>
    </header>

    <div class="article-body">
      <slot />
    </div>

    {tags.length > 0 && (
      <footer class="article-tags" aria-label="タグ">
        {tags.map((tag) => <span>#{tag}</span>)}
      </footer>
    )}
  </article>
</BaseLayout>

<style>
  .article {
    margin-inline: auto;
    max-width: 72rem;
    padding-top: clamp(3.5rem, 8vw, 7rem);
  }

  .article-header {
    margin: 0 auto clamp(3rem, 7vw, 5.5rem);
    max-width: 54rem;
    text-align: center;
  }

  .eyebrow {
    color: var(--color-clay);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    margin: 0 0 1.4rem;
  }

  h1 {
    font-family: var(--font-serif-ja);
    font-size: clamp(2.3rem, 6vw, 4.8rem);
    font-weight: 400;
    letter-spacing: 0.05em;
    line-height: 1.45;
    margin: 0;
  }

  .dek {
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 2;
    margin: 1.8rem auto 0;
    max-width: 37rem;
  }

  .article-meta {
    display: flex;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    gap: 1rem;
    justify-content: center;
    letter-spacing: 0.12em;
    margin-top: 1.6rem;
  }

  .article-body {
    font-family: var(--font-serif-ja);
    font-size: clamp(1rem, 1.8vw, 1.12rem);
    line-height: 2.15;
    margin-inline: auto;
    max-width: 43rem;
  }

  .article-body :global(h2) {
    font-size: clamp(1.45rem, 2.6vw, 2rem);
    font-weight: 500;
    line-height: 1.6;
    margin: 4.5rem 0 1.4rem;
  }

  .article-body :global(h3) {
    font-size: 1.2rem;
    font-weight: 600;
    margin: 3rem 0 1rem;
  }

  .article-body :global(p) {
    margin: 0 0 1.6rem;
  }

  .article-body :global(a) {
    color: var(--color-indigo);
    text-decoration-color: var(--color-clay);
    text-underline-offset: 0.24rem;
  }

  .article-body :global(blockquote) {
    border-left: 2px solid var(--color-clay);
    color: var(--color-muted);
    margin: 2.8rem 0;
    padding: 0.15rem 0 0.15rem 1.5rem;
  }

  .article-body :global(code) {
    background: color-mix(in srgb, var(--color-leaf) 9%, transparent);
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 0.16em 0.32em;
  }

  .article-body :global(pre) {
    background: var(--color-ink);
    color: var(--color-paper);
    overflow-x: auto;
    padding: 1.35rem;
  }

  .article-body :global(pre code) {
    background: transparent;
    padding: 0;
  }

  .article-tags {
    border-top: 1px solid var(--color-line);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.78rem;
    gap: 1rem;
    margin: 5rem auto 0;
    max-width: 43rem;
    padding-top: 1.4rem;
  }
</style>

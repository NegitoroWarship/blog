---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { withBase } from "../lib/paths";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  language?: "en" | "ja";
}

const {
  title = "Lines in Still Water",
  description = "Travel, technology, and life.",
  image = withBase("og.png"),
  type = "website",
  language = "en",
} = Astro.props;
const pageTitle = title === "Lines in Still Water" ? title : `${title} | Lines in Still Water`;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
const socialImage = Astro.site ? new URL(image, Astro.site) : new URL(image, Astro.url);
const siteName = "Lines in Still Water";
const homeUrl = Astro.site ? new URL(withBase(""), Astro.site).href : withBase("");
const isHome = canonical.href === homeUrl;
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  alternateName: siteName,
  url: homeUrl,
};
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="XXoKX0nyrO_DI4YybnSO1e-gvS6YR8FNU132buwkFEA" />
    <meta name="theme-color" content="#f3efe5" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Lines in Still Water RSS" href={withBase("rss.xml")} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="page-shell">
      <SiteHeader />
      <main id="main-content">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

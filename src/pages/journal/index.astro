---
import PostRow from "../../components/PostRow.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../lib/posts";

const posts = await getPublishedPosts();
---

<BaseLayout title="Journal" description="All essays on travel, places, tools, and technology.">
  <section class="section-page">
    <header class="section-heading">
      <h1>Journal</h1>
      <p>Notes on moving, making, and pausing—and what becomes visible in between.</p>
    </header>
    <div>{posts.map((post) => <PostRow post={post} />)}</div>
  </section>
</BaseLayout>

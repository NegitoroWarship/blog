---
import JournalCategories from "../../components/JournalCategories.astro";
import PostRow from "../../components/PostRow.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../lib/posts";

const posts = (await getPublishedPosts()).filter((post) => post.data.category === "places");
---

<BaseLayout title="Places" description="Field notes on cities, architecture, tables, and shelter from the rain.">
  <section class="section-page">
    <header class="section-heading">
      <h1>Places</h1>
      <p>City outlines, timeworn buildings, and the scent after rain—small memories gathered from place.</p>
    </header>
    <JournalCategories current="places" />
    <div>{posts.map((post) => <PostRow post={post} />)}</div>
  </section>
</BaseLayout>

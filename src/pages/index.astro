---
import { Image } from "astro:assets";
import PostRow from "../components/PostRow.astro";
import courtyard from "../assets/monsoon-courtyard.png";
import BaseLayout from "../layouts/BaseLayout.astro";
import { categoryLabels } from "../lib/posts";
import { getPublishedPosts } from "../lib/posts";
import { postPath, withBase } from "../lib/paths";

const posts = await getPublishedPosts();
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const remainingPosts = posts.filter((post) => post.id !== featured?.id);
---

<BaseLayout>
  {
    featured ? (
      <section class="feature" aria-labelledby="feature-title">
        <div class="feature-copy">
          <p class="eyebrow">{categoryLabels[featured.data.category]}</p>
          <h1 id="feature-title">{featured.data.title}</h1>
          <p class="feature-description">{featured.data.description}</p>
          <a class="read-more" href={postPath(featured.id)}>
            Read the story <span aria-hidden="true">→</span>
          </a>
        </div>

        <a class="feature-image" href={postPath(featured.id)} tabindex="-1" aria-hidden="true">
          <Image
            src={courtyard}
            alt="A quiet tropical courtyard with rain-darkened stone, lush foliage, and teak shutters"
            widths={[720, 1080, 1440]}
            sizes="(max-width: 800px) 100vw, 62vw"
            loading="eager"
          />
        </a>
      </section>
    ) : (
      <section class="empty-state">
        <h1>Lines in Still Water</h1>
        <p>The first letter is on its way.</p>
      </section>
    )
  }

  <section class="latest" aria-labelledby="latest-heading">
    <div class="latest-heading-row">
      <h2 id="latest-heading">Latest letters</h2>
      <a href={withBase("journal/")}>View all articles</a>
    </div>
    <div>
      {remainingPosts.map((post) => <PostRow post={post} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .feature {
    align-items: stretch;
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.65fr);
    padding: clamp(1.5rem, 3vw, 2.25rem) 0 2rem;
  }

  .feature-copy {
    align-self: center;
    padding: 1rem 0 1.5rem 0.65rem;
  }

  .eyebrow {
    color: var(--color-clay);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    margin: 0 0 1.45rem;
  }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.5vw, 3.45rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.65;
    margin: 0;
  }

  .feature-description {
    font-family: var(--font-serif);
    font-size: clamp(0.9rem, 1.3vw, 1.03rem);
    line-height: 2.15;
    margin: 1.4rem 0 0;
    max-width: 30rem;
  }

  .read-more {
    align-items: center;
    border-top: 1px solid var(--color-clay);
    color: inherit;
    display: inline-flex;
    font-family: var(--font-serif);
    gap: 1.5rem;
    margin-top: clamp(2rem, 5vw, 3.8rem);
    padding-top: 1.1rem;
    text-decoration: none;
  }

  .read-more:hover {
    color: var(--color-clay);
  }

  .feature-image {
    align-self: stretch;
    background: var(--color-leaf);
    display: block;
    min-height: 31rem;
    overflow: hidden;
  }

  .feature-image :global(img) {
    filter: saturate(0.78) contrast(0.98);
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
    width: 100%;
  }

  .feature-image:hover :global(img) {
    transform: scale(1.018);
  }

  .latest {
    border-bottom: 1px solid var(--color-line-soft);
    margin-top: 0.2rem;
  }

  .latest-heading-row {
    align-items: baseline;
    border-top: 1px solid var(--color-line);
    display: flex;
    justify-content: space-between;
    padding: 2.5rem 0 1rem;
  }

  .latest-heading-row h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    margin: 0;
  }

  .latest-heading-row a {
    color: var(--color-muted);
    font-family: var(--font-serif);
    font-size: 0.8rem;
    text-underline-offset: 0.3rem;
  }

  .empty-state {
    padding: 8rem 0;
  }

  @media (max-width: 860px) {
    .feature {
      grid-template-columns: 1fr;
    }

    .feature-copy {
      padding-left: 0;
    }

    .feature-image {
      min-height: 25rem;
      order: -1;
    }
  }

  @media (max-width: 540px) {
    .feature-image {
      min-height: 20rem;
    }

    .latest-heading-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>

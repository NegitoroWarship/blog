---
import PostRow from "../../components/PostRow.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../lib/posts";

const posts = (await getPublishedPosts()).filter((post) => post.data.category === "notes");
---

<BaseLayout title="Notes" description="技術と道具についての短いノート。">
  <section class="section-page">
    <header class="section-heading">
      <h1>Notes</h1>
      <p>旅先の開発環境、軽い道具、考え方。日々の制作を少し静かにするための技術メモ。</p>
    </header>
    <div>{posts.map((post) => <PostRow post={post} />)}</div>
  </section>
</BaseLayout>

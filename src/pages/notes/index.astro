---
import PostRow from "../../components/PostRow.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../lib/posts";

const posts = (await getPublishedPosts()).filter((post) => post.data.category === "notes");
---

<BaseLayout title="Notes" description="Short notes on technology and the tools we use.">
  <section class="section-page">
    <header class="section-heading">
      <h1>Notes</h1>
      <p>Portable development environments, lightweight tools, and ideas for a calmer creative practice.</p>
    </header>
    <div>{posts.map((post) => <PostRow post={post} />)}</div>
  </section>
</BaseLayout>

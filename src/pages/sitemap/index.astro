---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSitemapSections } from "../../lib/sitemap";

const sections = await getSitemapSections();
---

<BaseLayout title="Sitemap" description="An index of every page and published article on Lines in Still Water.">
  <section class="section-page sitemap-page">
    <header class="section-heading">
      <h1>Sitemap</h1>
      <p>An index of every page and published article on Lines in Still Water.</p>
    </header>

    <div class="sitemap-groups">
      <section class="sitemap-group" aria-labelledby="sitemap-pages">
        <h2 id="sitemap-pages">Pages</h2>
        <ul>
          {sections.pages.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </section>

      {sections.categories.length > 0 && (
        <section class="sitemap-group" aria-labelledby="sitemap-categories">
          <h2 id="sitemap-categories">Categories</h2>
          <ul>
            {sections.categories.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </section>
      )}

      <section class="sitemap-group sitemap-articles" aria-labelledby="sitemap-articles">
        <h2 id="sitemap-articles">Articles</h2>
        <ul>
          {sections.articles.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .sitemap-page {
    margin-inline: auto;
    max-width: 72rem;
  }

  .sitemap-groups {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .sitemap-group h2 {
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    margin: 0;
    padding-bottom: 0.8rem;
  }

  .sitemap-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sitemap-group li {
    border-bottom: 1px solid var(--color-line-soft);
  }

  .sitemap-group a {
    color: inherit;
    display: block;
    font-family: var(--font-serif);
    line-height: 1.65;
    padding: 1rem 0;
    text-decoration-color: transparent;
    text-underline-offset: 0.3rem;
  }

  .sitemap-group a:hover {
    color: var(--color-clay);
    text-decoration-color: currentColor;
  }

  .sitemap-articles {
    grid-column: 1 / -1;
  }

  @media (max-width: 680px) {
    .sitemap-groups {
      grid-template-columns: 1fr;
    }

    .sitemap-articles {
      grid-column: auto;
    }
  }
</style>

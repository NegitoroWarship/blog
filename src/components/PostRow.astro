---
import type { BlogPost } from "../lib/posts";
import { categoryLabels, formatDate } from "../lib/posts";
import { postPath } from "../lib/paths";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<article class="post-row">
  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
  <span class:list={["category", `category-${post.data.category}`]}>
    {categoryLabels[post.data.category]}
  </span>
  <h2><a href={postPath(post.id)}>{post.data.title}</a></h2>
  <p>{post.data.description}</p>
  <a class="arrow-link" href={postPath(post.id)} aria-label={`Read ${post.data.title}`}>
    <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  .post-row {
    align-items: center;
    border-top: 1px solid var(--color-line-soft);
    display: grid;
    gap: 1.2rem;
    grid-template-columns: 7rem 6.8rem minmax(16rem, 1.2fr) minmax(17rem, 1fr) auto;
    padding: 1.25rem 0;
  }

  time,
  .category {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
  }

  .category-journal { color: var(--color-clay); }
  .category-places { color: var(--color-indigo); }
  .category-notes { color: var(--color-leaf); }

  h2,
  p {
    margin: 0;
  }

  h2 {
    font-family: var(--font-serif);
    font-size: clamp(1rem, 1.45vw, 1.25rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.7;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--color-clay);
  }

  p {
    color: var(--color-muted);
    font-size: 0.78rem;
    line-height: 1.9;
  }

  .arrow-link {
    color: var(--color-clay);
    font-size: 1.5rem;
    padding: 0.5rem;
    text-decoration: none;
    transition: transform 180ms ease;
  }

  .arrow-link:hover {
    transform: translateX(0.25rem);
  }

  @media (max-width: 980px) {
    .post-row {
      grid-template-columns: 6.2rem 1fr auto;
    }

    .category {
      grid-column: 2;
      grid-row: 1;
    }

    h2 {
      grid-column: 1 / 3;
      grid-row: 2;
    }

    p {
      grid-column: 1 / 3;
      grid-row: 3;
    }

    .arrow-link {
      grid-column: 3;
      grid-row: 1 / 4;
    }
  }

  @media (max-width: 520px) {
    .post-row {
      gap: 0.65rem 1rem;
      grid-template-columns: auto 1fr auto;
      padding: 1.5rem 0;
    }

    time {
      grid-column: 1;
    }

    .category {
      grid-column: 2;
    }

    h2,
    p {
      grid-column: 1 / 4;
    }

    .arrow-link {
      display: none;
    }
  }
</style>
